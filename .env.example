# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Bearer token for every /api/* route. An EMPTY value disables auth entirely
# (anyone who reaches the port can drive your Agents). Production refuses to
# listen beyond loopback with fewer than 24 characters. The demo must set one:
# 24+ random characters, entered once in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# HTTPS (optional Caddy overlay, compose-only). A non-empty LAUNCHPAD_DOMAIN makes
# scripts/deploy-existing-ecs.sh add docker-compose.caddy.yml, putting Caddy with an
# automatic Let's Encrypt certificate on ports 80/443 in front of the app. Point the
# domain (a free duckdns.org name works) at the instance first, and pair it with
# PUBLIC_PORT=127.0.0.1:3000 above so the app port is loopback-only behind Caddy.
LAUNCHPAD_DOMAIN=
ACME_EMAIL=

# Model provider: ark (Volcengine/BytePlus Ark via Responses API) or openai.
MODEL_PROVIDER=ark

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Task Completion uses the configured Ark Responses model. `fake` is reserved
# for the deterministic repository E2E lane; normal environments keep `ark`.
TASK_COMPLETION_JUDGE=ark

# OpenAI (used when MODEL_PROVIDER=openai). OPENAI_MODEL is optional; Codex CLI
# picks its default model when it is empty.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
WORKSPACE_TEMPLATES_DIR=/app/workspace-templates
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# Workspace preview (#96, container runtime only): host ports the preview may publish on
# (loopback only, one port per running preview) and the lifetime cap before the container
# is removed without a request.
PREVIEW_PORT_RANGE=5180-5189
PREVIEW_TTL_MS=1800000
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# GlassBox observability. metadata_only stores IDs/timing/status/counts only;
# safe_summary adds bounded, redacted text summaries; reasoning_summary (opt-in, #259) adds
# everything safe_summary does plus 240-char redacted reasoning summaries. Raw capture does not exist.
GLASSBOX_CAPTURE_POLICY=metadata_only
# Demo-only: force a deterministic runtime timeout through the real Run path. Keep off.
GLASSBOX_DEMO_FAILURE=off
# Trace files (one NDJSON per Run). Defaults to $APP_DATA_DIR/traces.
# GLASSBOX_TRACE_DIR=
# Retention, applied once at startup. Runs whose last event is older than N days, or the oldest finished Runs
# while trace files exceed M MB, are compacted to terminal/error events + a trace.truncated tombstone (never
# deleted silently; running Runs are never touched). 0 disables that knob.
GLASSBOX_RETENTION_DAYS=7
GLASSBOX_MAX_DISK_MB=200
# Run-correlated server log ($APP_DATA_DIR/logs/server.ndjson, redacted on write); rotated at N MB, 3 files kept.
GLASSBOX_LOG_MAX_MB=50
# Optional cost estimates in currency units per million tokens. Hidden when all are unset.
# GLASSBOX_PRICE_PER_MTOK_INPUT=
# GLASSBOX_PRICE_PER_MTOK_CACHED_INPUT=
# GLASSBOX_PRICE_PER_MTOK_OUTPUT=
# Comma-separated commands post_check assertions may run in eval workspaces (#282). Operator-set,
# like an Agent's verifyCommand — a command not on this list fails the assertion closed.
GLASSBOX_POSTCHECK_ALLOWLIST=npm test
# Summary/evaluation store backend (#175): json (default, judged path) or postgres (needs DATABASE_URL).
GLASSBOX_STORE=json
# Postgres connection string; only read when GLASSBOX_STORE=postgres (compose profile provides one).
# DATABASE_URL=postgres://postgres:launchpad@localhost:5432/launchpad
# Keep isolated .eval/ workspaces after evaluation Runs instead of cleaning them (debugging aid).
KEEP_EVAL_WORKSPACES=0
